doctype html
html(lang="en")
  head
    meta(charset="UTF-8")
    meta(name="viewport" content="width=device-width, initial-scale=1.0")
    title Otter — Sign In
    link(rel="preconnect" href="https://fonts.googleapis.com")
    link(rel="preconnect" href="https://fonts.gstatic.com" crossorigin)
    link(href="https://fonts.googleapis.com/css2?family=Outfit:wght@400;500;600;700;800&display=swap" rel="stylesheet")
    link(rel="icon" type="image/x-icon" href="/favicon.ico")
    link(rel="icon" type="image/png" sizes="48x48" href="/favicon.png")
    link(rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png")
    link(rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png")
    link(rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png")
    link(rel="manifest" href="/manifest.json")
    meta(name="theme-color" content="#FEF4BB")
    link(rel="stylesheet" href="/style.css")
    script(src="https://accounts.google.com/gsi/client" async defer)
  body
    .bg-ambient-glow
    .login-container
      // Gaming Controller Art Header
      .controller-art
        img.controller-image(
          src="/assets/controller.png"
          alt="Gaming Controller"
        )

      // Main Form Card
      .login-card
        .card-header
          h1.app-title Otter
          p.app-subtitle Sign in to play with friends, share stories, and conquer the leaderboards.

        // Feedback / Error Banner
        #feedback-banner.feedback-banner.hidden
          span.feedback-icon
            svg(viewBox="0 0 24 24" width="16" height="16" stroke="currentColor" fill="none" stroke-width="2" stroke-linecap="round" stroke-linejoin="round")
              circle(cx="12" cy="12" r="10")
              line(x1="12" y1="8" x2="12" y2="12")
              line(x1="12" y1="16" x2="12.01" y2="16")
          span#feedback-text.feedback-text

        // Standard Login Form
        form#login-form.login-form(autocomplete="on")
          .form-group
            label(for="usernameOrEmail") Username or Email
            .input-wrapper
              span.input-icon
                svg(viewBox="0 0 24 24" width="18" height="18" stroke="currentColor" fill="none" stroke-width="2" stroke-linecap="round" stroke-linejoin="round")
                  path(d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2")
                  circle(cx="12" cy="7" r="4")
              input#usernameOrEmail(
                type="text"
                name="usernameOrEmail"
                placeholder="e.g. alex_rivera"
                required
                autocomplete="username"
              )

          .form-group
            label(for="password") Password
            .input-wrapper
              span.input-icon
                svg(viewBox="0 0 24 24" width="18" height="18" stroke="currentColor" fill="none" stroke-width="2" stroke-linecap="round" stroke-linejoin="round")
                  rect(x="3" y="11" width="18" height="11" rx="2" ry="2")
                  path(d="M7 11V7a5 5 0 0 1 10 0v4")
              input#password(
                type="password"
                name="password"
                placeholder="••••••••"
                required
                autocomplete="current-password"
              )
              button#toggle-password.toggle-password-btn(
                type="button"
                aria-label="Toggle password visibility"
              )
                svg.eye-icon(viewBox="0 0 24 24" width="18" height="18" stroke="currentColor" fill="none" stroke-width="2" stroke-linecap="round" stroke-linejoin="round")
                  path(d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z")
                  circle(cx="12" cy="12" r="3")
                svg.eye-off-icon.hidden(viewBox="0 0 24 24" width="18" height="18" stroke="currentColor" fill="none" stroke-width="2" stroke-linecap="round" stroke-linejoin="round")
                  path(d="M17.94 17.94A10.07 10.07 0 0 1 12 20c-7 0-11-8-11-8a18.45 18.45 0 0 1 5.06-5.94M9.9 4.24A9.12 9.12 0 0 1 12 4c7 0 11 8 11 8a18.5 18.5 0 0 1-2.16 3.19m-6.72-1.07a3 3 0 1 1-4.24-4.24")
                  line(x1="1" y1="1" x2="23" y2="23")

          .forgot-row
            a#forgot-password-link.forgot-link(href="#") Forgot Password?

          // Primary Pink Sign In Button
          button#signin-btn.btn.btn-primary(type="submit")
            span.btn-text Sign In
            span.btn-spinner.hidden
            svg.btn-arrow(viewBox="0 0 24 24" width="18" height="18" stroke="currentColor" fill="none" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round")
              polyline(points="9 18 15 12 9 6")

        // Subtle "OR" Divider
        .divider
          span.divider-line
          span.divider-text OR
          span.divider-line

        // Charcoal Google Sign-In Button
        button#google-signin-btn.btn.btn-google(type="button")
          img.google-icon(src="/assets/google-icon.svg" alt="Google")
          span.google-btn-text Continue with Google
          span.google-spinner.hidden

        // Card Footer
        .card-footer
          span Don't have an account? 
          a#create-account-link.signup-link(href="#") Create Account

    script(src="/script.js")
