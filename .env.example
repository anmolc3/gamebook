# Global Development Environment Configuration
PORT=5000
NODE_ENV=development

# Database Configuration (PostgreSQL 16+)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/gameapp_dev?schema=public"

# Authentication Security
JWT_SECRET="super-secret-development-key-change-in-production-32chars"
JWT_EXPIRES_IN="7d"

# CORS and Network
CORS_ORIGIN="*"

# Real-Time Gateway URL (Consumed by Mobile client)
EXPO_PUBLIC_API_URL="http://localhost:5000/api/v1"
EXPO_PUBLIC_SOCKET_URL="http://localhost:5000"

# Email Configuration (Free Gmail App Password)
# 1. Enable 2-Step Verification on your Google Account
# 2. Go to myaccount.google.com/apppasswords and create an app password for 'Gamebook'
# 3. Paste your gmail and 16-character password below
GMAIL_USER="your-email@gmail.com"
GMAIL_APP_PASSWORD="abcd efgh ijkl mnop"
EMAIL_FROM="\"Social Gaming Arena\" <your-email@gmail.com>"
