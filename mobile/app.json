{
  "expo": {
    "name": "Otter",
    "slug": "social-gaming-arena",
    "scheme": "socialgamingarena",
    "version": "1.0.0",
    "runtimeVersion": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "updates": {
      "fallbackToCacheTimeout": 0
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.socialgaming.arena",
      "buildNumber": "1"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#FEF4BB"
      },
      "package": "com.socialgaming.arena",
      "versionCode": 1,
      "softwareKeyboardLayoutMode": "resize",
      "permissions": [
        "POST_NOTIFICATIONS",
        "NOTIFICATIONS",
        "CAMERA",
        "RECORD_AUDIO",
        "RECEIVE_BOOT_COMPLETED",
        "VIBRATE",
        "WAKE_LOCK",
        "INTERNET",
        "ACCESS_NETWORK_STATE"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "notification": {
      "icon": "./assets/otter-notification-white.png",
      "color": "#3ED598"
    },
    "plugins": [
      "expo-camera",
      "expo-asset",
      [
        "expo-notifications",
        {
          "icon": "./assets/otter-notification-white.png",
          "color": "#3ED598",
          "defaultChannel": "default",
          "sounds": []
        }
      ],
      "expo-audio",
      "expo-web-browser",
      "expo-video"
    ],
    "extra": {
      "eas": {
        "projectId": "aa4e799c-184c-4ea7-800e-e8ddfd8925cb"
      }
    },
    "owner": "anmolruhals-team"
  }
}
