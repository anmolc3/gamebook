{
  "cli": {
    "version": ">= 3.0.0"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "android": {
        "buildType": "apk"
      }
    },
    "preview": {
      "distribution": "internal",
      "android": {
        "buildType": "apk"
      },
      "env": {
        "EXPO_PUBLIC_API_URL": "https://YOUR_RAILWAY_URL.railway.app/api/v1",
        "EXPO_PUBLIC_SOCKET_URL": "https://YOUR_RAILWAY_URL.railway.app"
      }
    },
    "production": {
      "android": {
        "buildType": "app-bundle"
      },
      "env": {
        "EXPO_PUBLIC_API_URL": "https://YOUR_RAILWAY_URL.railway.app/api/v1",
        "EXPO_PUBLIC_SOCKET_URL": "https://YOUR_RAILWAY_URL.railway.app"
      }
    }
  },
  "submit": {
    "production": {}
  }
}
